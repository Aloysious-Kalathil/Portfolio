# ── Frontend (exposed to the browser — only public values here) ──────────────
# reCAPTCHA v3 site key: https://www.google.com/recaptcha/admin/create
VITE_RECAPTCHA_SITE_KEY=

# ── Server only (used by /api/verify-and-send.js, never bundled) ─────────────
# reCAPTCHA v3 secret key (same admin page as the site key)
RECAPTCHA_SECRET_KEY=
# Minimum score to accept (0.0 = bot, 1.0 = human). Google recommends 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=
# Sender. Use "Portfolio <onboarding@resend.dev>" until you verify a domain.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
